	rdfs:label "accepted_count" ;
	rdfs:range _:c14n25 ;
	skos:inScheme <https://example.org/work> .
work:actions a owl:ObjectProperty ;
	rdfs:label "actions" ;
	rdfs:range work:Action ;
	skos:inScheme <https://example.org/work> .
work:actor a owl:ObjectProperty ;
	rdfs:label "actor" ;
	rdfs:range work:Actor ;
	skos:inScheme <https://example.org/work> .
work:actor_kind a owl:ObjectProperty ;
	rdfs:label "actor_kind" ;
	rdfs:range work:ActorKind ;
	skos:inScheme <https://example.org/work> .
work:actors a owl:ObjectProperty ;
