@prefix pav: <http://purl.org/pav/> .
<https://example.org/work.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:title "Work, a vocabulary for governed work by people and agents" ;
	pav:version "0.1.0-draft" ;
	a owl:Ontology ;
	rdfs:label "work" ;
	skos:definition "The core of a draft open standard. It defines work (what should be done and how success is judged), who does it and on whose authority, what was actually done, and how it turned out. Domain profiles extend it (access is the first); a customer's own specifics extend a profile in their own namespace and never edit the core. Every other format (OCSF, OpenTelemetry, Ossie, ServiceNow's tables, Veza, Armis, Moveworks) is a mapping or a projection of this source. Draft: identifiers use example.org until the vocabulary has a home." .
work:AcceptanceCriterion a owl:Class ;
	rdfs:label "AcceptanceCriterion" ;
	rdfs:subClassOf _:c14n119 , _:c14n139 , _:c14n233 , _:c14n271 , _:c14n313 , _:c14n334 , _:c14n338 , _:c14n51 , _:c14n76 ;
	skos:definition "How an outcome of a step is judged right. Judged after the reversal window closes." ;
	skos:inScheme <https://example.org/work> .
work:Action a owl:Class ;
	rdfs:label "Action" ;
	rdfs:subClassOf _:c14n107 , _:c14n134 , _:c14n136 , _:c14n147 , _:c14n158 , _:c14n168 , _:c14n176 , _:c14n192 , _:c14n195 , _:c14n197 , _:c14n199 , _:c14n2 , _:c14n222 , _:c14n226 , _:c14n278 , _:c14n286 , _:c14n303 , _:c14n310 , _:c14n319 , _:c14n320 , _:c14n37 , _:c14n39 , _:c14n53 , _:c14n7 ;
	skos:definition "Something an actor did to a system, as observed in telemetry. Governed actions belong to a request; an action without one is the first kind of gap." ;
	skos:exactMatch prov:Activity ;
	skos:inScheme <https://example.org/work> ;
	work:namespace "action" .
work:Actor a owl:Class ;
	rdfs:label "Actor" ;
	rdfs:subClassOf _:c14n12 , _:c14n155 , _:c14n161 , _:c14n169 , _:c14n182 , _:c14n216 , _:c14n236 , _:c14n251 , _:c14n252 , _:c14n269 , _:c14n272 , _:c14n284 , _:c14n285 , _:c14n291 , _:c14n3 , _:c14n47 , _:c14n48 , _:c14n95 ;
	skos:definition "A person, agent, service account or system that can take part in work." ;
	skos:exactMatch prov:Agent ;
	skos:inScheme <https://example.org/work> ;
	work:namespace "actor" .
work:ActorKind\#agent a owl:Class ;
	rdfs:label "agent" ;
	rdfs:subClassOf work:ActorKind .
work:ActorKind\#person a owl:Class ;
	rdfs:label "person" ;
	rdfs:subClassOf work:ActorKind .
work:ActorKind\#service_account a owl:Class ;
	rdfs:label "service_account" ;
	rdfs:subClassOf work:ActorKind .
work:ActorKind\#system a owl:Class ;
	rdfs:label "system" ;
	rdfs:subClassOf work:ActorKind .
work:ActorKind a owl:Class ;
	rdfs:label "ActorKind" ;
	owl:unionOf _:c14n83 ;
	skos:inScheme <https://example.org/work> ;
	linkml:permissible_values work:ActorKind\#agent , work:ActorKind\#person , work:ActorKind\#service_account , work:ActorKind\#system .
work:AutonomyChange a owl:Class ;
	rdfs:label "AutonomyChange" ;
	rdfs:subClassOf _:c14n1 , _:c14n101 , _:c14n113 , _:c14n122 , _:c14n141 , _:c14n159 , _:c14n16 , _:c14n163 , _:c14n187 , _:c14n20 , _:c14n219 , _:c14n225 , _:c14n237 , _:c14n248 , _:c14n276 , _:c14n29 , _:c14n308 , _:c14n324 , _:c14n329 , _:c14n44 , _:c14n80 , _:c14n89 , _:c14n92 ;
	skos:definition "A promotion or demotion of a capability, with the evidence that justified it." ;
	skos:inScheme <https://example.org/work> ;
	work:namespace "autonomy_change" .
work:AutonomyLevel\#act a owl:Class ;
	rdfs:label "act" ;
	rdfs:subClassOf work:AutonomyLevel ;
	skos:definition "Acts; a person can review." .
work:AutonomyLevel\#act_and_report a owl:Class ;
	rdfs:label "act_and_report" ;
	rdfs:subClassOf work:AutonomyLevel ;
	skos:definition "Acts and reports in aggregate." .
work:AutonomyLevel\#act_with_checkpoint a owl:Class ;
	rdfs:label "act_with_checkpoint" ;
	rdfs:subClassOf work:AutonomyLevel ;
	skos:definition "Acts after a person approves." .
work:AutonomyLevel\#assist a owl:Class ;
	rdfs:label "assist" ;
	rdfs:subClassOf work:AutonomyLevel ;
	skos:definition "Proposes; a person acts." .
work:AutonomyLevel a owl:Class ;
	rdfs:label "AutonomyLevel" ;
	owl:unionOf _:c14n218 ;
	skos:definition "The earned autonomy ladder. Promotion follows evidence; demotion is immediate." ;
	skos:inScheme <https://example.org/work> ;
	linkml:permissible_values work:AutonomyLevel\#act , work:AutonomyLevel\#act_and_report , work:AutonomyLevel\#act_with_checkpoint , work:AutonomyLevel\#assist .
work:Capability a owl:Class ;
	rdfs:label "Capability" ;
	rdfs:subClassOf _:c14n100 , _:c14n137 , _:c14n15 , _:c14n170 , _:c14n178 , _:c14n186 , _:c14n215 , _:c14n22 , _:c14n265 , _:c14n277 , _:c14n281 , _:c14n287 , _:c14n297 , _:c14n306 , _:c14n309 , _:c14n31 , _:c14n314 , _:c14n335 , _:c14n38 , _:c14n84 , _:c14n93 ;
	skos:definition "An actor's standing to perform a step: the autonomy level it holds now and the evidence behind it. Permission comes from the authority systems; proven ability comes from outcomes in the record." ;
	skos:inScheme <https://example.org/work> ;
	work:namespace "capability" .
work:ChangeKind\#autonomy a owl:Class ;
	rdfs:label "autonomy" ;
	rdfs:subClassOf work:ChangeKind ;
	skos:definition "Who may act unattended. Proved by outcomes." .
work:ChangeKind\#declared_policy a owl:Class ;
	rdfs:label "declared_policy" ;
	rdfs:subClassOf work:ChangeKind ;
	skos:definition "The rules the work runs under. Proved by approval history, out of sample." .
work:ChangeKind\#repair a owl:Class ;
	rdfs:label "repair" ;
	rdfs:subClassOf work:ChangeKind ;
	skos:definition "How the work is defined. Proved by replaying history." .
work:ChangeKind a owl:Class ;
	rdfs:label "ChangeKind" ;
	owl:unionOf _:c14n179 ;
	skos:definition "The three things whose change is earned on evidence." ;
	skos:inScheme <https://example.org/work> ;
	linkml:permissible_values work:ChangeKind\#autonomy , work:ChangeKind\#declared_policy , work:ChangeKind\#repair .
work:Confirmation a owl:Class ;
	rdfs:label "Confirmation" ;
	rdfs:subClassOf _:c14n103 , _:c14n116 , _:c14n143 , _:c14n171 , _:c14n175 , _:c14n202 , _:c14n204 , _:c14n21 , _:c14n210 , _:c14n223 , _:c14n238 , _:c14n253 , _:c14n274 , _:c14n299 , _:c14n57 , _:c14n58 , _:c14n63 , _:c14n82 ;
	skos:definition "A person's decision on a proposed change: a repair, a declared policy or an autonomy promotion. Nothing proposed is applied without one. Bound to the proposal's content by a digest in its id, so a changed proposal needs a new confirmation. In a deployment, written by a person; a demo may write labelled stand-ins." ;
	skos:inScheme <https://example.org/work> ;
	work:namespace "confirmation" .
work:Decision a owl:Class ;
	rdfs:label "Decision" ;
	rdfs:subClassOf _:c14n0 , _:c14n124 , _:c14n151 , _:c14n183 , _:c14n196 , _:c14n213 , _:c14n224 , _:c14n311 , _:c14n332 , _:c14n333 , _:c14n42 , _:c14n54 ;
	skos:definition "An authority decision on a step, taken outside the model that proposed the action." ;
	skos:inScheme <https://example.org/work> ;
	work:namespace "decision" .
work:DecisionEffect\#allow a owl:Class ;
	rdfs:label "allow" ;
	rdfs:subClassOf work:DecisionEffect .
work:DecisionEffect\#checkpoint a owl:Class ;
	rdfs:label "checkpoint" ;
	rdfs:subClassOf work:DecisionEffect .
work:DecisionEffect\#deny a owl:Class ;
	rdfs:label "deny" ;
	rdfs:subClassOf work:DecisionEffect .
work:DecisionEffect a owl:Class ;
	rdfs:label "DecisionEffect" ;
	owl:unionOf _:c14n212 ;
	skos:inScheme <https://example.org/work> ;
	linkml:permissible_values work:DecisionEffect\#allow , work:DecisionEffect\#checkpoint , work:DecisionEffect\#deny .
work:Gap a owl:Class ;
	rdfs:label "Gap" ;
	rdfs:subClassOf _:c14n108 , _:c14n114 , _:c14n190 , _:c14n255 , _:c14n301 , _:c14n35 , _:c14n40 , _:c14n41 , _:c14n43 , _:c14n50 , _:c14n55 , _:c14n61 , _:c14n62 , _:c14n68 ;
	skos:definition "Something observed that does not fit the vocabulary, or fits with a required part missing. A gap is written in the same terms as its remedy." ;
	skos:inScheme <https://example.org/work> ;
	work:namespace "gap" .
work:GapKind\#dead_customisation a owl:Class ;
	rdfs:label "dead_customisation" ;
	rdfs:subClassOf work:GapKind ;
	skos:definition "A customisation that never runs." .
work:GapKind\#drift a owl:Class ;
	rdfs:label "drift" ;
	rdfs:subClassOf work:GapKind ;
	skos:definition "Grants in an authority system that no request explains." .
work:GapKind\#duplicate_definition a owl:Class ;
	rdfs:label "duplicate_definition" ;
	rdfs:subClassOf work:GapKind ;
	skos:definition "Several definitions of the same work." .
work:GapKind\#idle_privilege a owl:Class ;
	rdfs:label "idle_privilege" ;
	rdfs:subClassOf work:GapKind ;
	skos:definition "A grant no governed task has used." .
work:GapKind\#orphan_action a owl:Class ;
	rdfs:label "orphan_action" ;
	rdfs:subClassOf work:GapKind ;
	skos:definition "An action with no request." .
work:GapKind\#policy_candidate a owl:Class ;
	rdfs:label "policy_candidate" ;
	rdfs:subClassOf work:GapKind ;
	skos:definition "An approval that history shows is a formality: a candidate for declared policy." .
work:GapKind\#unregistered_actor a owl:Class ;
	rdfs:label "unregistered_actor" ;
	rdfs:subClassOf work:GapKind ;
	skos:definition "An actor acting that the registry does not know." .
work:GapKind\#vocabulary a owl:Class ;
	rdfs:label "vocabulary" ;
	rdfs:subClassOf work:GapKind ;
	skos:definition "Something observed that the vocabulary cannot express; a gap in the standard." .
work:GapKind a owl:Class ;
	rdfs:label "GapKind" ;
	owl:unionOf _:c14n138 ;
	skos:inScheme <https://example.org/work> ;
	linkml:permissible_values work:GapKind\#dead_customisation , work:GapKind\#drift , work:GapKind\#duplicate_definition , work:GapKind\#idle_privilege , work:GapKind\#orphan_action , work:GapKind\#policy_candidate , work:GapKind\#unregistered_actor , work:GapKind\#vocabulary .
work:Outcome a owl:Class ;
	rdfs:label "Outcome" ;
	rdfs:subClassOf _:c14n102 , _:c14n13 , _:c14n177 , _:c14n209 , _:c14n242 , _:c14n243 , _:c14n245 , _:c14n71 , _:c14n96 ;
	skos:definition "How a step turned out, judged against its acceptance criteria." ;
	skos:inScheme <https://example.org/work> ;
	work:namespace "outcome" .
work:OutcomeStatus\#abandoned a owl:Class ;
	rdfs:label "abandoned" ;
	rdfs:subClassOf work:OutcomeStatus .
work:OutcomeStatus\#accepted a owl:Class ;
	rdfs:label "accepted" ;
	rdfs:subClassOf work:OutcomeStatus .
work:OutcomeStatus\#failed a owl:Class ;
	rdfs:label "failed" ;
	rdfs:subClassOf work:OutcomeStatus .
work:OutcomeStatus\#reassigned a owl:Class ;
	rdfs:label "reassigned" ;
	rdfs:subClassOf work:OutcomeStatus .
work:OutcomeStatus\#reopened a owl:Class ;
	rdfs:label "reopened" ;
	rdfs:subClassOf work:OutcomeStatus .
work:OutcomeStatus\#reversed a owl:Class ;
	rdfs:label "reversed" ;
	rdfs:subClassOf work:OutcomeStatus ;
	skos:definition "Undone within the reversal window." .
work:OutcomeStatus a owl:Class ;
	rdfs:label "OutcomeStatus" ;
	owl:unionOf _:c14n258 ;
	skos:inScheme <https://example.org/work> ;
	linkml:permissible_values work:OutcomeStatus\#abandoned , work:OutcomeStatus\#accepted , work:OutcomeStatus\#failed , work:OutcomeStatus\#reassigned , work:OutcomeStatus\#reopened , work:OutcomeStatus\#reversed .
work:Record a owl:Class ;
	rdfs:label "Record" ;
	rdfs:subClassOf _:c14n117 , _:c14n150 , _:c14n164 , _:c14n167 , _:c14n184 , _:c14n191 , _:c14n244 , _:c14n261 , _:c14n270 , _:c14n289 , _:c14n292 , _:c14n315 , _:c14n331 , _:c14n336 , _:c14n46 , _:c14n59 , _:c14n66 , _:c14n69 , _:c14n88 , _:c14n9 ;
	skos:definition "A container for exchanging the record." ;
	skos:inScheme <https://example.org/work> .
work:RiskClass\#high a owl:Class ;
	rdfs:label "high" ;
	rdfs:subClassOf work:RiskClass .
work:RiskClass\#low a owl:Class ;
	rdfs:label "low" ;
	rdfs:subClassOf work:RiskClass .
work:RiskClass\#medium a owl:Class ;
	rdfs:label "medium" ;
	rdfs:subClassOf work:RiskClass .
work:RiskClass a owl:Class ;
	rdfs:label "RiskClass" ;
	owl:unionOf _:c14n321 ;
	skos:inScheme <https://example.org/work> ;
	linkml:permissible_values work:RiskClass\#high , work:RiskClass\#low , work:RiskClass\#medium .
work:StepDefinition a owl:Class ;
	rdfs:label "StepDefinition" ;
	rdfs:subClassOf _:c14n105 , _:c14n126 , _:c14n142 , _:c14n201 , _:c14n220 , _:c14n254 , _:c14n27 , _:c14n280 , _:c14n288 , _:c14n296 , _:c14n330 , _:c14n337 , _:c14n4 , _:c14n5 , _:c14n56 , _:c14n72 , _:c14n8 ;
	skos:definition "One step of a kind of work. Autonomy is earned per step, not per agent." ;
	skos:inScheme <https://example.org/work> ;
	work:namespace "step" .
work:TaskRecord a owl:Class ;
	rdfs:label "TaskRecord" ;
	rdfs:subClassOf _:c14n10 , _:c14n111 , _:c14n112 , _:c14n125 , _:c14n127 , _:c14n133 , _:c14n146 , _:c14n148 , _:c14n160 , _:c14n166 , _:c14n19 , _:c14n227 , _:c14n23 , _:c14n230 , _:c14n231 , _:c14n234 , _:c14n235 , _:c14n239 , _:c14n247 , _:c14n249 , _:c14n259 , _:c14n26 , _:c14n260 , _:c14n266 , _:c14n279 , _:c14n294 , _:c14n298 , _:c14n307 , _:c14n317 , _:c14n323 , _:c14n326 , _:c14n36 , _:c14n78 ;
	skos:definition "One step performed under a request. A task with no request is not a task: it is an orphan action, and fails validation by construction." ;
	skos:exactMatch prov:Activity ;
	skos:inScheme <https://example.org/work> ;
	work:namespace "task" .
work:Verdict\#approve a owl:Class ;
	rdfs:label "approve" ;
	rdfs:subClassOf work:Verdict .
work:Verdict\#reject a owl:Class ;
	rdfs:label "reject" ;
	rdfs:subClassOf work:Verdict .
work:Verdict a owl:Class ;
	rdfs:label "Verdict" ;
	owl:unionOf _:c14n24 ;
	skos:inScheme <https://example.org/work> ;
	linkml:permissible_values work:Verdict\#approve , work:Verdict\#reject .
work:WorkDefinition a owl:Class ;
	rdfs:label "WorkDefinition" ;
	rdfs:subClassOf _:c14n120 , _:c14n131 , _:c14n17 , _:c14n174 , _:c14n189 , _:c14n203 , _:c14n257 , _:c14n300 , _:c14n322 , _:c14n45 , _:c14n73 , _:c14n74 , _:c14n81 , _:c14n87 ;
	skos:definition "A kind of work the organisation does, as a sequence of steps." ;
	skos:inScheme <https://example.org/work> ;
	work:namespace "work_definition" .
work:WorkEvent a owl:Class ;
	rdfs:label "WorkEvent" ;
	rdfs:subClassOf _:c14n118 , _:c14n121 , _:c14n123 , _:c14n128 , _:c14n129 , _:c14n132 , _:c14n135 , _:c14n149 , _:c14n152 , _:c14n153 , _:c14n154 , _:c14n185 , _:c14n188 , _:c14n194 , _:c14n200 , _:c14n246 , _:c14n256 , _:c14n262 , _:c14n264 , _:c14n267 , _:c14n268 , _:c14n290 , _:c14n295 , _:c14n30 , _:c14n32 , _:c14n34 , _:c14n60 , _:c14n65 , _:c14n75 , _:c14n77 , _:c14n79 , _:c14n94 , _:c14n98 ;
	skos:definition "Something that happened to a request or a task. The one record every lens projects from: security (OCSF), operations (OpenTelemetry), analytics and agents (Ossie), and chat. Events are hash-chained." ;
	skos:inScheme <https://example.org/work> ;
	work:namespace "event" .
work:WorkEventKind\#approved a owl:Class ;
	rdfs:label "approved" ;
	rdfs:subClassOf work:WorkEventKind .
work:WorkEventKind\#completed a owl:Class ;
	rdfs:label "completed" ;
	rdfs:subClassOf work:WorkEventKind .
work:WorkEventKind\#decided a owl:Class ;
	rdfs:label "decided" ;
	rdfs:subClassOf work:WorkEventKind .
work:WorkEventKind\#demoted a owl:Class ;
	rdfs:label "demoted" ;
	rdfs:subClassOf work:WorkEventKind .
work:WorkEventKind\#overridden a owl:Class ;
	rdfs:label "overridden" ;
	rdfs:subClassOf work:WorkEventKind .
work:WorkEventKind\#promoted a owl:Class ;
	rdfs:label "promoted" ;
	rdfs:subClassOf work:WorkEventKind .
work:WorkEventKind\#rejected a owl:Class ;
	rdfs:label "rejected" ;
	rdfs:subClassOf work:WorkEventKind .
work:WorkEventKind\#requested a owl:Class ;
	rdfs:label "requested" ;
	rdfs:subClassOf work:WorkEventKind .
work:WorkEventKind\#reversed a owl:Class ;
	rdfs:label "reversed" ;
	rdfs:subClassOf work:WorkEventKind .
work:WorkEventKind\#started a owl:Class ;
	rdfs:label "started" ;
	rdfs:subClassOf work:WorkEventKind .
work:WorkEventKind\#stopped a owl:Class ;
	rdfs:label "stopped" ;
	rdfs:subClassOf work:WorkEventKind ;
	skos:definition "Halted by an authority outside the performer, e.g. security." .
work:WorkEventKind a owl:Class ;
	rdfs:label "WorkEventKind" ;
	owl:unionOf _:c14n49 ;
	skos:inScheme <https://example.org/work> ;
	linkml:permissible_values work:WorkEventKind\#approved , work:WorkEventKind\#completed , work:WorkEventKind\#decided , work:WorkEventKind\#demoted , work:WorkEventKind\#overridden , work:WorkEventKind\#promoted , work:WorkEventKind\#rejected , work:WorkEventKind\#requested , work:WorkEventKind\#reversed , work:WorkEventKind\#started , work:WorkEventKind\#stopped .
work:WorkMetric\#agent_share a owl:Class ;
	rdfs:label "agent_share" ;
	rdfs:subClassOf work:WorkMetric ;
	skos:definition "Share of tasks performed by agents rather than people." ;
	work:expression "AVG(CASE WHEN actors.actor_kind = 'agent' THEN 1.0 ELSE 0.0 END)" ;
	work:table "tasks" .
work:WorkMetric\#first_pass_yield a owl:Class ;
	rdfs:label "first_pass_yield" ;
	rdfs:subClassOf work:WorkMetric ;
	skos:definition "Share of completed tasks accepted without being reversed, reopened or reassigned." ;
	work:expression "AVG(CASE WHEN tasks.outcome_status = 'accepted' THEN 1.0 ELSE 0.0 END)" ;
	work:table "tasks" .
work:WorkMetric\#orphan_actions a owl:Class ;
	rdfs:label "orphan_actions" ;
	rdfs:subClassOf work:WorkMetric ;
	skos:definition "Number of observed actions with no request." ;
	work:expression "COALESCE(SUM(CASE WHEN actions.request IS NULL THEN 1 ELSE 0 END), 0)" ;
	work:table "actions" .
work:WorkMetric\#reversal_rate a owl:Class ;
	rdfs:label "reversal_rate" ;
	rdfs:subClassOf work:WorkMetric ;
	skos:definition "Share of completed tasks reversed within their window." ;
	work:expression "AVG(CASE WHEN tasks.outcome_status = 'reversed' THEN 1.0 ELSE 0.0 END)" ;
	work:table "tasks" .
work:WorkMetric\#stops a owl:Class ;
	rdfs:label "stops" ;
	rdfs:subClassOf work:WorkMetric ;
	skos:definition "Number of steps halted by an authority outside the performer." ;
	work:expression "COALESCE(SUM(CASE WHEN events.kind = 'stopped' THEN 1 ELSE 0 END), 0)" ;
	work:table "events" .
work:WorkMetric a owl:Class ;
	rdfs:label "WorkMetric" ;
	owl:unionOf _:c14n293 ;
	skos:definition "The measures of work performance (ISA-95 production performance; ISO 22400 in spirit). Each value carries its definition as SQL over the record's tables, so every consumer computes it the same way." ;
	skos:inScheme <https://example.org/work> ;
	linkml:permissible_values work:WorkMetric\#agent_share , work:WorkMetric\#first_pass_yield , work:WorkMetric\#orphan_actions , work:WorkMetric\#reversal_rate , work:WorkMetric\#stops .
work:WorkRequest a owl:Class ;
	rdfs:label "WorkRequest" ;
	rdfs:subClassOf _:c14n104 , _:c14n106 , _:c14n11 , _:c14n110 , _:c14n156 , _:c14n165 , _:c14n18 , _:c14n193 , _:c14n198 , _:c14n206 , _:c14n217 , _:c14n282 , _:c14n302 , _:c14n312 , _:c14n316 , _:c14n318 , _:c14n325 , _:c14n328 , _:c14n33 , _:c14n6 , _:c14n85 ;
	skos:definition "A request for a kind of work, from a person or an agent, on someone's behalf." ;
	skos:inScheme <https://example.org/work> ;
	work:namespace "request" .
